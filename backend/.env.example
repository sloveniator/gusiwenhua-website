# 139 邮箱 SMTP 发信配置
# 复制本文件为同目录下的 .env 并填入真实值；.env 不入库、不进镜像
SMTP_HOST=smtp.139.com
# 端口：465 = SSL（139 邮箱常用）
SMTP_PORT=465
# 发信账号（139 邮箱完整地址）
SMTP_USER=Slceleto@139.com
# 客户端专用密码 / 授权码（不是邮箱登录密码；139 邮箱在设置-账户安全里生成授权码）
SMTP_PASS=your_139_smtp_password
# 接收邮箱（咨询落到哪里）
SMTP_TO=Slceleto@gmail.com
# 发件人显示（与发信账号一致，否则 139 服务器可能拒发）
SMTP_FROM=Slceleto@139.com
