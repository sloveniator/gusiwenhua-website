# 163 邮箱 SMTP 发信配置
# 复制本文件为同目录下的 .env 并填入真实值；.env 不入库、不进镜像
SMTP_HOST=smtp.163.com
# 端口：Racknerd 等低价 VPS 通常封锁出站 465/587/994，仅开放 25；
#       故默认 25（STARTTLS）。若你的服务器放行 465，可改 465（SSL）
SMTP_PORT=25
# 发信账号（163 邮箱完整地址）
SMTP_USER=Slceleto@163.com
# 客户端专用密码 / 授权码（不是邮箱登录密码；163 邮箱在设置-客户端授权密码里生成）
SMTP_PASS=your_163_smtp_password
# 接收邮箱（咨询落到哪里）
SMTP_TO=Slceleto@gmail.com
# 发件人显示（与发信账号一致，否则 163 服务器可能拒发）
SMTP_FROM=Slceleto@163.com
