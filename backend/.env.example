# 腾讯企业邮 SMTP 发信配置
# 复制本文件为同目录下的 .env 并填入真实值；.env 不入库、不进镜像
SMTP_HOST=smtp.exmail.qq.com
# 端口：465 = SSL，587 = STARTTLS
SMTP_PORT=465
# 发信账号（通常为完整企业微信邮箱）
SMTP_USER=contact@g4create.cn
# 客户端专用密码 / 授权码（不是邮箱登录密码，在企业微信邮箱设置里生成）
SMTP_PASS=your_client_smtp_password
# 接收邮箱（咨询落到哪里）
SMTP_TO=contact@g4create.cn
# 发件人显示（可与 SMTP_USER 相同）
SMTP_FROM=contact@g4create.cn
